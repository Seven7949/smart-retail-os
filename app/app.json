{
  "expo": {
    "name": "Dukaan AI",
    "slug": "dukaan-ai",
    "scheme": "dukaanai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F4EF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartretailos.dukaanai"
    },
    "android": {
      "package": "com.smartretailos.dukaanai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F766E"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dukaan AI uses the camera to read supplier invoices into your stock.",
          "photosPermission": "Dukaan AI reads supplier invoice photos you choose."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dukaan AI listens when you tap the mic to create a bill by voice.",
          "speechRecognitionPermission": "Dukaan AI turns your spoken order into a bill.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
